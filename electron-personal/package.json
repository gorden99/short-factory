{
  "name": "short-factory-personal",
  "version": "1.0.0",
  "description": "短稿工场个人版 - AI 短视频文案批量生产工具（Windows 桌面版）",
  "main": "main.js",
  "author": "南宁和奥电子有限公司",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "dmg-license": "^1.0.11"
  },
  "build": {
    "appId": "com.hao.shortfactory.personal",
    "productName": "短稿工场个人版",
    "directories": {
      "output": "../downloads"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "短稿工场个人版",
      "artifactName": "短稿工场个人版安装包.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "短稿工场个人版-Mac-${arch}.${ext}"
    }
  }
}